# Copy this content into .env, then replace every CHANGE-ME value before starting the local TIG stack.
INFLUXDB_DB=mdt
INFLUXDB_ADMIN_USER=labadmin
INFLUXDB_ADMIN_PASSWORD=CHANGE-ME-use-a-long-password
INFLUXDB_WRITE_USER=telegraf
INFLUXDB_WRITE_USER_PASSWORD=CHANGE-ME-use-a-long-password
INFLUXDB_READ_USER=grafana
INFLUXDB_READ_USER_PASSWORD=CHANGE-ME-use-a-long-password
GRAFANA_USERNAME=admin
GRAFANA_PASSWORD=CHANGE-ME-use-a-long-password
