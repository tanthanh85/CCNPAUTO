# Copy this content into .env, then replace every CHANGE-ME value before starting the local TIG stack.
INFLUX_USERNAME=labadmin
INFLUX_PASSWORD=CHANGE-ME-use-a-long-password
INFLUX_ORG=ccnpauto
INFLUX_BUCKET=workstation
INFLUX_TOKEN=CHANGE-ME-use-a-long-random-token
GRAFANA_USERNAME=admin
GRAFANA_PASSWORD=CHANGE-ME-use-a-long-password
