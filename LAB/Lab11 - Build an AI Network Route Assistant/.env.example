# Copy this content into .env, then add the active sandbox and provider values.
# Cisco IOS XE reservable sandbox RESTCONF details.
IOSXE_HOST=REPLACE_WITH_IOSXE_SANDBOX_HOST
IOSXE_RESTCONF_PORT=443
IOSXE_USERNAME=REPLACE_WITH_USERNAME
IOSXE_PASSWORD=REPLACE_WITH_PASSWORD
IOSXE_VERIFY_TLS=false

# Select exactly one provider: ollama, vllm, openai, or anthropic
LLM_PROVIDER=ollama
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=800

# Option A: local Ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Option B: local or private vLLM OpenAI-compatible server
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_MODEL=Qwen/Qwen3-8B
VLLM_API_KEY=lab11-local-key

# Option C: OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Option D: Anthropic API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_VERSION=2023-06-01

# Flask details
FLASK_HOST=127.0.0.1
FLASK_PORT=5050
FLASK_DEBUG=false

# Diagnostic logging. Set ENABLE_FILE_LOGGING=true while studying or troubleshooting.
ENABLE_FILE_LOGGING=false
ENABLE_CONSOLE_LOGGING=true
LOG_LEVEL=DEBUG
LOG_CONSOLE_LEVEL=INFO
LOG_DIR=logs
