# Copy this content into .env, then add the active IOS XE and Splunk values.
IOSXE_HOST=REPLACE_WITH_SANDBOX_HOST
IOSXE_NETCONF_PORT=830
IOSXE_USERNAME=REPLACE_WITH_SANDBOX_USERNAME
IOSXE_PASSWORD=REPLACE_WITH_SANDBOX_PASSWORD
IOSXE_HOSTKEY_VERIFY=false

SPLUNK_HEC_URL=https://127.0.0.1:8088
SPLUNK_HEC_TOKEN=REPLACE_WITH_HEC_TOKEN
SPLUNK_HEC_VERIFY_TLS=false
SPLUNK_INDEX=network_telemetry

SUBSCRIPTION_PERIOD=500
NOTIFICATION_TIMEOUT=30
