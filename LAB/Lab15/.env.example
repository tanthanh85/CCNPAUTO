# Cisco IOS XE reservable sandbox RESTCONF details
IOSXE_HOST=10.10.20.48
IOSXE_RESTCONF_PORT=443
IOSXE_USERNAME=developer
IOSXE_PASSWORD=REDACTED
IOSXE_VERIFY_TLS=false

# Select exactly one provider: ollama, openai, or anthropic
LLM_PROVIDER=ollama
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=800

# Option A: local Ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Option B: OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Option C: Anthropic API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_VERSION=2023-06-01

# Flask details
FLASK_HOST=127.0.0.1
FLASK_PORT=5050
FLASK_DEBUG=false
