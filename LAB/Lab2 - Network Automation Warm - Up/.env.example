# Copy this content into .env, then enter values from the active Cisco DevNet Sandbox reservation.
IOSXE_HOST=REPLACE_WITH_SANDBOX_HOST_OR_IP
IOSXE_SSH_PORT=22
IOSXE_HTTPS_PORT=443
IOSXE_USERNAME=REPLACE_WITH_USERNAME
IOSXE_PASSWORD=REPLACE_WITH_PASSWORD

# False is appropriate only for the controlled sandbox certificate.
VERIFY_TLS=false
