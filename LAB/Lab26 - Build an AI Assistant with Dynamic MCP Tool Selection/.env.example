# Copy this file to .env and replace the placeholders.
IOSXE_HOST=REPLACE_WITH_IOSXE_HOST
IOSXE_RESTCONF_PORT=443
IOSXE_USERNAME=REPLACE_WITH_USERNAME
IOSXE_PASSWORD=REPLACE_WITH_PASSWORD
IOSXE_VERIFY_TLS=false
# Optional: leave blank unless your IOS XE release exposes a different route resource.
IOSXE_ROUTE_ENDPOINT=

# Select ollama, vllm, or openai.
LLM_PROVIDER=ollama
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=900
MAX_AGENT_ITERATIONS=5
MAX_TOOL_CALLS=4

# Local Ollama with a tool-capable Qwen model.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Optional OpenAI-compatible vLLM service.
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_MODEL=Qwen/Qwen3-8B
VLLM_API_KEY=lab26-local-key

# Optional OpenAI API.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

FLASK_HOST=127.0.0.1
FLASK_PORT=5056
FLASK_DEBUG=false

ENABLE_FILE_LOGGING=true
ENABLE_CONSOLE_LOGGING=true
LOG_LEVEL=DEBUG
LOG_CONSOLE_LEVEL=INFO
LOG_DIR=logs
