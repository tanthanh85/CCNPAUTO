# Copy this content into .env when starting the cumulative project.
# IOS XE endpoint. Enter values from the active reservation.
IOSXE_HOST=REPLACE_WITH_SANDBOX_HOST_OR_IP
IOSXE_SSH_PORT=22
IOSXE_HTTPS_PORT=443
IOSXE_NETCONF_PORT=830
IOSXE_USERNAME=REPLACE_WITH_USERNAME
IOSXE_PASSWORD=REPLACE_WITH_PASSWORD
VERIFY_TLS=false

# NetBox source of truth.
NETBOX_URL=http://127.0.0.1:8080
NETBOX_TOKEN=REPLACE_WITH_NETBOX_API_TOKEN
NETBOX_DEVICE=iosxe-sandbox
NETBOX_TAG=automation-managed

# Vault credential store.
VAULT_ADDR=http://127.0.0.1:8200
VAULT_MOUNT=secret
VAULT_IOSXE_PATH=ccnpauto/iosxe

# OSPF intent.
OSPF_PROCESS_ID=1
OSPF_AREA=0

# Diagnostic logging. Set ENABLE_FILE_LOGGING=true while studying or troubleshooting.
ENABLE_FILE_LOGGING=false
ENABLE_CONSOLE_LOGGING=true
LOG_LEVEL=DEBUG
LOG_CONSOLE_LEVEL=INFO
LOG_DIR=logs
